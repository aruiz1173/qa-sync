# OpenAI (visión)
# Obligatorio: codex, claude u openai_api. No hay proveedor predeterminado.
QA_SYNC_VISION_PROVIDER=
QA_SYNC_VISION_QUALITY=high
QA_SYNC_ALLOW_PROVIDER_FALLBACK=false
QA_SYNC_FALLBACK_PROVIDER=
QA_SYNC_CODEX_MODEL=
QA_SYNC_CLAUDE_MODEL=
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4o
QA_SYNC_MAX_IMAGES=16
QA_SYNC_MAX_RECORDING_SECONDS=900
# 0..1. Below this confidence, AI verification requires a manual verdict.
QA_SYNC_MIN_VERIFICATION_CONFIDENCE=0.8
# Opcional: confía únicamente en builds Android concretos cuando Homebrew o un binario
# sin firma sea rechazado. QA Sync muestra el SHA-256 exacto que hay que registrar.
# QA_SYNC_TRUSTED_HASHES=adb=<sha256>,emulator=<sha256>,scrcpy=<sha256>
# Usa review_only para generar y editar propuestas sin permitir escrituras.
QA_SYNC_WRITE_MODE=confirm

# Opcional en macOS: úsalo si Xcode no está en /Applications o xcode-select apunta
# sólo a Command Line Tools. No cambia la configuración global del sistema.
# QA_SYNC_DEVELOPER_DIR=/ruta/a/Xcode.app/Contents/Developer

# TestRail. No agregues /index.php?/api/v2 al URL.
TESTRAIL_URL=https://tu-equipo.testrail.io
TESTRAIL_EMAIL=qa@empresa.com
TESTRAIL_API_KEY=...
TESTRAIL_PROJECT_ID=1

# Ajusta estos nombres a los campos personalizados de tu instancia.
TESTRAIL_STEPS_FIELD=custom_steps_separated
TESTRAIL_PRECONDITIONS_FIELD=custom_preconds

# Opcional: campo y valores de plataforma definidos en TestRail.
TESTRAIL_PLATFORM_FIELD=custom_platform
TESTRAIL_ANDROID_VALUE=1
TESTRAIL_IOS_VALUE=2

# Opcional: control guiado de Simulator o iPhone físico con Appium/XCUITest.
APPIUM_URL=http://127.0.0.1:4723
IOS_BUNDLE_ID=com.example.mobile
APPIUM_CAPABILITIES_JSON='{"appium:xcodeOrgId":"TEAM_ID","appium:updatedWDABundleId":"com.example.WebDriverAgentRunner"}'
QA_SYNC_IOS_DEVICES_JSON='[{"id":"UDID","name":"iPhone QA","version":"18.1"}]'
